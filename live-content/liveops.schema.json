{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ferfranky.github.io/foodball-go-site/live-content/liveops.schema.json",
  "title": "Foodball Go LiveOps catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "min_client_version", "updated_at", "seasons", "achievements"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "min_client_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_at": { "type": "string", "format": "date-time" },
    "seasons": { "type": "array", "items": { "$ref": "#/$defs/season" } },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "en"],
      "properties": {
        "es": { "$ref": "#/$defs/copyEntry" },
        "en": { "$ref": "#/$defs/copyEntry" }
      }
    },
    "copyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "player_character_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "game_modes": { "type": "array", "minItems": 1, "items": { "enum": ["free_play", "tournament"] } },
        "tournament_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "collectible_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "target"],
      "properties": {
        "event": {
          "enum": [
            "goal_scored",
            "own_goal_scored",
            "match_won",
            "match_completed",
            "tournament_match_won",
            "tournament_completed",
            "tournament_won",
            "tournament_round_reached",
            "sticker_purchased"
          ]
        },
        "target": { "type": "integer", "minimum": 1 },
        "filters": { "$ref": "#/$defs/filters" },
        "round": { "enum": ["quarterfinal", "semifinal", "final", "champion"] }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "const": "coins" },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cadence", "starts_at", "ends_at", "sort_order", "copy", "objective", "reward"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cadence": { "enum": ["daily", "weekly", "season"] },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "sort_order": { "type": "integer", "minimum": 0 },
        "copy": { "$ref": "#/$defs/copy" },
        "objective": { "$ref": "#/$defs/objective" },
        "reward": { "$ref": "#/$defs/reward" }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "starts_at", "ends_at", "sort_order", "copy", "challenges"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["scheduled", "published", "archived"] },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": "string", "format": "date-time" },
        "sort_order": { "type": "integer", "minimum": 0 },
        "copy": { "$ref": "#/$defs/copy" },
        "art": { "$ref": "#/$defs/asset" },
        "challenges": { "type": "array", "items": { "$ref": "#/$defs/challenge" } }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sort_order", "visibility", "copy", "objective", "reward"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sort_order": { "type": "integer", "minimum": 0 },
        "visibility": { "enum": ["visible", "hidden_until_unlocked"] },
        "copy": { "$ref": "#/$defs/copy" },
        "objective": { "$ref": "#/$defs/objective" },
        "reward": { "$ref": "#/$defs/reward" }
      }
    }
  }
}

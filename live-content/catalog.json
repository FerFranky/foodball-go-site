      "story": {
        "es": {
          "title": "El Guardián de la Ofrenda",
          "role": "Delantero de la Ofrenda",
          "trait": "Memoria dulce",
          "nationality": "México",
          "bio": "Cada Día de Muertos baja a la cancha para honrar a quienes ya partieron. Con azúcar en la cabeza y fuego en el corazón, convierte cada gol en una ofrenda de alegría."
        },
        "en": {
          "title": "Guardian of the Altar",
          "role": "Altar Forward",
          "trait": "Sweet remembrance",
          "nationality": "Mexico",
          "bio": "Every Day of the Dead, he takes the pitch to honor those who came before. With sugar on his crown and fire in his heart, he turns every goal into an offering of joy."
        }
      },

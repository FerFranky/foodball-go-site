      "story": {
        "es": {
          "title": "El Rayo de Canela",
          "role": "Extremo Crujiente",
          "trait": "Energía dulce",
          "nationality": "España",
          "bio": "Desde la feria hasta la cancha, acelera con azúcar y canela. Cuando el partido se aprieta, su chispa convierte cualquier rebote en una carrera inolvidable."
        },
        "en": {
          "title": "The Cinnamon Bolt",
          "role": "Crunchy Winger",
          "trait": "Sweet energy",
          "nationality": "Spain",
          "bio": "From the fairground to the pitch, he sprints on sugar and cinnamon. When the match gets tight, his spark turns every rebound into an unforgettable run."
        }
      },
